{
  "name": "tablet-streaming-app",
  "version": "1.0.0",
  "description": "Netflix-like video streaming app for Android tablets",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:web": "vite build",
    "build:apk": "npm run build:web && npm run cap:sync && npm run android:build",
    "cap:sync": "npx cap sync android",
    "android:build": "cd android && ./gradlew assembleDebug && cd ..",
    "android:release": "cd android && ./gradlew assembleRelease && cd ..",
    "android:clean": "cd android && ./gradlew clean && cd ..",
    "build:full": "npm run android:clean && npm run build:apk"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "hls.js": "^1.6.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "vite": "^6.0.0"
  }
}
